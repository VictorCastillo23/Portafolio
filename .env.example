# Copy this file to .env.local and fill in real values. All variables here
# are optional at build time: `next build` succeeds with every one of them
# absent -- only the chat widget degrades (unmounted) when they are missing.
# See app/api/chat/route.ts and app/page.tsx.

# Anthropic API key used to generate chat responses.
ANTHROPIC_API_KEY=

# Anthropic model id used for chat generation. Defaults to a current
# small/fast Claude model when unset -- confirm the exact id in lib/chat/.
ANTHROPIC_MODEL=
